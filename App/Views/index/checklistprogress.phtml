  <script>
    $(document).ready(function() {
      var table = $('#tbchecklistprogress').DataTable({
        "language": {
          "lengthMenu": "Exibir _MENU_ registros por página",
          "zeroRecords": "Nenhum checklist em andamento encontrado",
          "info": "Mostrando _START_ a _END_ de _TOTAL_ registros",
          "infoEmpty": "Mostrando 0 a 0 de 0 registros",
          "infoFiltered": "(filtrado de _MAX_ registros no total)",
          "search": "Buscar:",
          "paginate": {
            "first": "Primeiro",
            "last": "Último",
            "next": "Próximo",
            "previous": "Anterior"
          }
        },
        "order": [[ 7, "desc" ]],
        "responsive": true
      });

      $('#tbchecklistprogress tbody').on('click', 'tr.clickable-row', function() {
        var nrWorkorder = $(this).data('nr-workorder');
        if (nrWorkorder) {
          $.ajax({
            url: '/newchecklist?nr_workorder=' + encodeURIComponent(nrWorkorder),
            method: 'POST',
            dataType: 'html'
          }).done(function(data) {
            $('#ajax-content').html(data);
          }).fail(function() {
            window.location.href = '/newchecklist?nr_workorder=' + encodeURIComponent(nrWorkorder);
          });
        }
      });
    });
  </script>
