<script>
function previewPhotoUser(inputId = 'ds_photo', previewId = 'previewFoto') {
    const input = document.getElementById(inputId);
    const preview = document.getElementById(previewId);
    const file = input.files[0];

    if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
            preview.src = e.target.result;
        };
        reader.readAsDataURL(file);
    }
}

let deleteUserId = null;

function formatLevel(level) {
    return level === '1' || level === 1 ? 'Administrador' : 'Usuário';
}

$(document).ready(function() {
    $(document).on('click', '.edit-user', function() {
        const id = $(this).data('id');
        $.get('/get_user', { id: id }, function(response) {
            if (response && response.id) {
                $('#editUserId').val(response.id);
                $('#edit_nm_name').val(response.nm_name);
                $('#edit_nm_login').val(response.nm_login);
                $('#edit_ds_email').val(response.ds_email);
                $('#edit_nr_phone').val(response.nr_phone);
                $('#edit_ds_address').val(response.ds_address);                
                $('#edit_ds_active').prop('checked', response.ds_active == 1);
                $('#edit_id_position').val(response.id_position || '');
                $('#edit_id_role').val(response.id_role || '');
                $('#previewFotoEdit').attr('src', response.ds_photo ? response.ds_photo : '/dist/img/sem-foto.jpg');
                $('#modalEditarUsuario').modal('show');
            }
        }, 'json');
    });

    $(document).on('click', '#btnUpdateUser', function() {
        let formData = new FormData($('#editUserForm')[0]);
        $.ajax({
            type: 'post',
            url: '/update_user',
            data: formData,
            processData: false,
            contentType: false,
            dataType: 'json',
            success: function(response) {
                if (response.success) {
                    toastr.success('Usuário atualizado com sucesso!');
                    $('#modalEditarUsuario').modal('hide');
                    location.reload();
                } else {
                    toastr.error(response.message);
                }
            },
            error: function() {
                toastr.error('Erro ao atualizar usuário.');
            }
        });
    });

    $(document).on('click', '.info-user', function() {
        const id = $(this).data('id');
        $.get('/get_user', { id: id }, function(response) {
            if (response && response.id) {
                $('#infoUserPhoto').attr('src', response.ds_photo ? response.ds_photo : '/dist/img/sem-foto.jpg');
                $('#info_nm_name').text(response.nm_name);
                $('#info_nm_login').text(response.nm_login);
                $('#info_ds_email').text(response.ds_email);
                $('#info_nr_phone').text(response.nr_phone);
                $('#info_ds_address').text(response.ds_address);
                $('#info_ds_position').text(response.ds_position || '');
                $('#info_ds_role').text(response.ds_role || '');                
                $('#info_ds_active').text(response.ds_active == 1 ? 'Sim' : 'Não');
                $('#modalUserInfo').modal('show');
            }
        }, 'json');
    });

    $(document).on('click', '.lock-user', function() {
        $('#modalPermissions').modal('show');
    });

    $(document).on('click', '.btn-delete-user', function() {
        deleteUserId = $(this).data('id');
        $('#modalExcluirUsuario').modal('show');
    });

    $('#confirmDeleteBtn').click(function() {
        if (!deleteUserId) return;
        $.post('/delete_user', { id: deleteUserId }, function(response) {
            if (response.success) {
                toastr.success('Usuário excluído com sucesso!');
                $('#modalExcluirUsuario').modal('hide');
                location.reload();
            } else {
                toastr.error('Erro ao excluir usuário.');
            }
        }, 'json');
    });

    $(document).on('change', '.toggle-active', function() {
        const id = $(this).data('id');
        const active = $(this).is(':checked') ? 1 : 0;
        const checkbox = $(this);
        const row = checkbox.closest('tr');
        $.post('/toggle_user_active', { id: id, active: active }, function(response) {
            if (response.success) {
                checkbox.attr('title', active ? 'Desativar usuário' : 'Ativar usuário');
                row.toggleClass('user-inactive-row', !active);
                toastr.success('Status do usuário atualizado.');
            } else {
                toastr.error('Erro ao atualizar status.');
                checkbox.prop('checked', !active);
            }
        }, 'json');
    });
});
</script>






