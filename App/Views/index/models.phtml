  <script src="/plugins/datatables/jquery.dataTables.min.js"></script>
  <script src="/plugins/datatables/dataTables.bootstrap.min.js"></script>
  <script>
    $(function(){
      var dtConfig = { language: { url: '/plugins/datatables/Portuguese.json' } };
      $('#tbmodels').DataTable(dtConfig);

      function showToast(message, type) {
        toastr.options = { closeButton: true, progressBar: true, positionClass: 'toast-top-right', timeOut: '3000' };
        if (type === 'success') { toastr.success(message); }
        else { toastr.error(message); }
      }

      function showAlert(selector, message) {
        var el = $(selector);
        el.removeClass('alert-success alert-danger').addClass('alert-danger');
        el.text(message).show();
      }

      function refreshModelsTable(callback) {
        $.post('/listmodel', function(html){
          var tbody = $(html).find('#tbmodels tbody');
          var table = $('#tbmodels').DataTable();
          table.destroy();
          $('#tbmodels tbody').html(tbody.html());
          $('#tbmodels').DataTable(dtConfig);
          if (typeof callback === 'function') callback();
        });
      }

      // Save
      $('#btnSaveModel').on('click', function(){
        var form = $('#formModel');
        $.ajax({ url: form.attr('action'), method: 'POST', data: form.serialize(), dataType: 'json' })
        .done(function(res){
          if(res.success){
            $('#modalRegModel').modal('hide');
            form[0].reset();
            showToast('Modelo cadastrado com sucesso.', 'success');
            refreshModelsTable();
          } else { showAlert('#modelCreateAlert', res.message || 'Erro ao salvar modelo'); }
        }).fail(function(){ showAlert('#modelCreateAlert', 'Erro ao salvar modelo'); });
      });

      // Edit
      $('#tbmodels').on('click', '.edit-model', function(){
        var id = $(this).data('id');
       
        $.getJSON('/get_model?id=' + id, function(data){
          if(!data || !data.id) { showToast('Registro não encontrado', 'error'); return; }
          $('#edit_model_id').val(data.id);
          $('#edit_id_mark').val(data.id_mark);
          $('#edit_ds_model').val(data.ds_model);
          $('#edit_type_model').val(data.type_model);
          $('#modelEditAlert').hide();
          $('#modalEditModel').modal('show');
        }).fail(function(){ showToast('Erro ao buscar modelo', 'error'); });
      });

      // Update
      $('#btnUpdateModel').on('click', function(){
        var form = $('#formEditModel');
        $.ajax({ url: form.attr('action'), method: 'POST', data: form.serialize(), dataType: 'json' })
        .done(function(res){
          if(res.success){
            $('#modalEditModel').modal('hide');
            showToast('Modelo atualizado com sucesso.', 'success');
            refreshModelsTable();
          } else { showAlert('#modelEditAlert', res.message || 'Erro ao atualizar modelo'); }
        }).fail(function(){ showAlert('#modelEditAlert', 'Erro ao atualizar modelo'); });
      });

      // Delete
      var deleteModelId = null;

      $('#tbmodels').on('click', '.delete-model', function(){
        deleteModelId = $(this).data('id');
        $('#modalExcluirModelo').modal('show');
      });

      $('#confirmDeleteModelBtn').click(function(){
        if(!deleteModelId) return;
        $.post('/delete_model', { id: deleteModelId }, function(res){
          if(res.success){
            $('#modalExcluirModelo').modal('hide');
            showToast('Exclusão realizada com sucesso.', 'error');
            refreshModelsTable();
          } else {
            $('#modalExcluirModelo').modal('hide');
            showToast(res.message || 'Erro ao excluir', 'error');
          }
        }, 'json').fail(function(){
          $('#modalExcluirModelo').modal('hide');
          showToast('Erro na requisição', 'error');
        });
      });
    });
  </script>

