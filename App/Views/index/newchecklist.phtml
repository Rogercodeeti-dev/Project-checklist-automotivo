            <i class="fa fa-trash confirm-trash-icon"></i>
          </div>
          <p class="confirm-message" id="deleteMessage">Tem certeza que deseja excluir esta mídia?</p>
          <p class="confirm-item-name" id="deleteItemName"></p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-default btn-cancel-delete" data-dismiss="modal">
            <i class="fa fa-times"></i> Cancelar
          </button>
          <button type="button" class="btn btn-danger btn-confirm-delete" id="btnConfirmDelete">
            <i class="fa fa-trash"></i> Excluir
          </button>
        </div>
      </div>
    </div>
  </div>

