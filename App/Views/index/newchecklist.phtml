  <div class="">
    <section class="content-header">
      <h1>Novo Checklist</h1>
    </section>

    <section class="content">
      <div class="box box-primary">
        <div class="box-header with-border">
          <h3 class="box-title">Criar Novo Checklist</h3>
        </div>
        <div class="box-body">
          <!-- Wizard Steps -->
          <div class="wizard-steps">
            <ul class="nav nav-pills nav-justified">
              <li class="active" data-step="1">
                <a href="#">
                  <span class="badge">1</span> Dados do Atendimento
                </a>
              </li>
              <li data-step="2">
                <a href="#">
                  <span class="badge">2</span> Dados do Veículo
                </a>
              </li>
              <li data-step="3">
                <a href="#">
                  <span class="badge">3</span> Registro Visual
                </a>
              </li>
            </ul>
          </div>

          <hr>

          <!-- Step 1: Dados do Atendimento -->
          <div id="step1" class="wizard-step-content">
            <form id="formChecklistStep1">
              <div class="row">
                <div class="col-md-3">
                  <div class="form-group">
                    <label>Data do Atendimento</label>
                    <input type="date" name="dt_service" id="dt_service" class="form-control" readonly>
                  </div>
                </div>
                <div class="col-md-2">
                  <div class="form-group">
                    <label>Hora do Atendimento</label>
                    <input type="time" name="hr_service" id="hr_service" class="form-control" readonly>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="form-group">
                    <label>Cliente</label>
                    <input type="text" name="nm_client" class="form-control" placeholder="Nome do cliente" required>
                  </div>
                </div>
                <div class="col-md-3">
                  <div class="form-group">
                    <label>Telefone</label>
                    <input type="text" name="nr_phone" class="form-control" placeholder="(00) 00000-0000">
                  </div>
                </div>
              </div>

              <div class="row">
                <div class="col-md-12">
                  <div class="form-group">
                    <label>E-mail</label>
                    <input type="email" name="ds_email" class="form-control" placeholder="email@exemplo.com">
                  </div>
                </div>
              </div>

              <div class="row">
                <div class="col-md-12">
                  <div class="form-group">
                    <label>Relato do Cliente</label>
                    <textarea name="ds_report" class="form-control" rows="4" placeholder="Descreva o relato do cliente..." required></textarea>
                  </div>
                </div>
              </div>

              <div class="form-group text-right">
                <button type="button" class="btn btn-primary btn-next" data-step="1">
                  Próximo <i class="fa fa-arrow-right"></i>
                </button>
              </div>
            </form>
          </div>

          <!-- Step 2: Dados do Veículo -->
          <div id="step2" class="wizard-step-content" style="display: none;">
            <form id="formChecklistStep2">
              <div class="row">
                <div class="col-md-4">
                  <div class="form-group">
                    <label>Placa do Veículo</label>
                    <input type="text" name="nr_plate" class="form-control" placeholder="ABC-1234" required>
                  </div>
                </div>
                <div class="col-md-8">
                  <div class="form-group">
                    <label>Veículo</label>
                    <input type="text" name="nm_vehicle" class="form-control" placeholder="Modelo do veículo" required>
                  </div>
                </div>
              </div>

              <div class="row">
                <div class="col-md-4">
                  <div class="form-group">
                    <label>Cor</label>
                    <input type="text" name="ds_color" class="form-control" placeholder="Cor do veículo">
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="form-group">
                    <label>Ano</label>
                    <input type="text" name="nr_year" class="form-control" placeholder="Ano do veículo">
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="form-group">
                    <label>Quilometragem</label>
                    <input type="text" name="nr_km" class="form-control" placeholder="Quilometragem atual">
                  </div>
                </div>
              </div>

              <div class="row">
                <div class="col-md-12">
                  <div class="form-group">
                    <label>Nível de Combustível</label>
                    <div class="fuel-gauge-container">
                      <div class="fuel-gauge">
                        <div class="fuel-gauge-fill" id="fuelGaugeFill"></div>
                        <div class="fuel-gauge-icons">
                          <i class="fa fa-battery-empty"></i>
                          <i class="fa fa-battery-quarter"></i>
                          <i class="fa fa-battery-half"></i>
                          <i class="fa fa-battery-three-quarters"></i>
                          <i class="fa fa-battery-full"></i>
                        </div>
                      </div>
                      <input type="range" name="nr_fuel" id="fuelSlider" min="0" max="100" value="50" class="fuel-slider">
                      <div class="fuel-percentage" id="fuelPercentage">50%</div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="form-group">
                <button type="button" class="btn btn-default btn-prev" data-step="2">
                  <i class="fa fa-arrow-left"></i> Voltar
                </button>
                <button type="button" class="btn btn-primary btn-next pull-right" data-step="2">
                  Próximo <i class="fa fa-arrow-right"></i>
                </button>
              </div>
            </form>
          </div>

          <!-- Step 3: Registro Visual -->
          <div id="step3" class="wizard-step-content" style="display: none;">
            <div class="row">
              <!-- Seção de Fotos -->
              <div class="col-md-6">
                <div class="box box-success">
                  <div class="box-header with-border">
                    <h3 class="box-title"><i class="fa fa-camera"></i> Fotos</h3>
                  </div>
                  <div class="box-body">
                    <div class="text-center">
                      <video id="cameraPreview" class="camera-preview" autoplay playsinline></video>
                      <canvas id="photoCanvas" style="display: none;"></canvas>
                      <div class="btn-group" style="margin-top: 15px;">
                        <button type="button" class="btn btn-success btn-lg" id="btnCapturePhoto" disabled>
                          <i class="fa fa-camera"></i> Capturar Foto
                        </button>
                        <button type="button" class="btn btn-default" id="btnToggleCamera">
                          <i class="fa fa-refresh"></i> Trocar Câmera
                        </button>
                      </div>
                    </div>

                    <div id="photosContainer" class="media-cards-container" style="margin-top: 20px;">
                      <!-- Cards de fotos serão inseridos aqui -->
                    </div>
                  </div>
                </div>
              </div>

              <!-- Seção de Vídeos -->
              <div class="col-md-6">
                <div class="box box-info">
                  <div class="box-header with-border">
                    <h3 class="box-title"><i class="fa fa-video-camera"></i> Vídeos</h3>
                  </div>
                  <div class="box-body">
                    <div class="text-center">
                      <video id="videoPreview" class="camera-preview" autoplay playsinline></video>
                      <div class="btn-group" style="margin-top: 15px;">
                        <button type="button" class="btn btn-danger btn-lg" id="btnStartRecording" disabled>
                          <i class="fa fa-circle"></i> Iniciar Gravação
                        </button>
                        <button type="button" class="btn btn-warning btn-lg" id="btnStopRecording" disabled>
                          <i class="fa fa-stop"></i> Parar Gravação
                        </button>
                      </div>
                      <div id="recordingTimer" class="recording-timer" style="display: none;">
                        <i class="fa fa-circle text-danger blink"></i> Gravando: <span id="timerDisplay">00:00</span>
                      </div>
                    </div>

                    <div id="videosContainer" class="media-cards-container" style="margin-top: 20px;">
                      <!-- Cards de vídeos serão inseridos aqui -->
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="form-group" style="margin-top: 20px;">
              <button type="button" class="btn btn-default btn-prev" data-step="3">
                <i class="fa fa-arrow-left"></i> Voltar
              </button>
              <button type="button" class="btn btn-success btn-save-checklist pull-right">
                <i class="fa fa-save"></i> Salvar Checklist
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Modal de Validação -->
  <div class="modal fade" id="modalValidation" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal">&times;</button>
          <h4 class="modal-title">Campos Obrigatórios</h4>
        </div>
        <div class="modal-body">
          <div class="alert alert-warning">
            <i class="fa fa-exclamation-triangle"></i>
            <span id="validationMessage">Por favor, preencha todos os campos obrigatórios.</span>
          </div>
          <ul id="validationList" class="list-group">
            <!-- Lista de campos faltantes será inserida aqui -->
          </ul>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal de Preview de Mídia -->
  <div class="modal fade" id="modalMediaPreview" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal">&times;</button>
          <h4 class="modal-title" id="mediaPreviewTitle">Preview</h4>
        </div>
        <div class="modal-body text-center">
          <div id="mediaPreviewContent"></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-default" data-dismiss="modal">Fechar</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal de Confirmação de Exclusão -->
  <div class="modal fade" id="modalConfirmDelete" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-confirm-delete" role="document">
      <div class="modal-content">
        <div class="modal-header modal-header-danger">
          <button type="button" class="close" data-dismiss="modal">&times;</button>
          <h4 class="modal-title"><i class="fa fa-exclamation-triangle"></i> Confirmar Exclusão</h4>
        </div>
        <div class="modal-body text-center">
