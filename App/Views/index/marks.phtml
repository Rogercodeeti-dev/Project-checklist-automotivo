  <script src="/plugins/datatables/jquery.dataTables.min.js"></script>
  <script src="/plugins/datatables/dataTables.bootstrap.min.js"></script>
  <script>
    $(function(){
      var dtConfig = { language: { url: '/plugins/datatables/Portuguese.json' } };
      $('#tbmarks').DataTable(dtConfig);

      function showToast(message, type) {
        toastr.options = { closeButton: true, progressBar: true, positionClass: 'toast-top-right', timeOut: '3000' };
        if (type === 'success') { toastr.success(message); }
        else { toastr.error(message); }
      }

      function showMarkAlert(selector, message) {
        var el = $(selector);
        el.removeClass('alert-success alert-danger').addClass('alert-danger');
        el.text(message).show();
      }

      function refreshMarksTable(callback) {
        $.post('/listmark', function(html){
          var tbody = $(html).find('#tbmarks tbody');
          var table = $('#tbmarks').DataTable();
          table.destroy();
          $('#tbmarks tbody').html(tbody.html());
          $('#tbmarks').DataTable(dtConfig);
          if (typeof callback === 'function') callback();
        });
      }

      $('#btnSaveMark').on('click', function(){
        var form = $('#formMark');
        $.ajax({ url: form.attr('action'), method: 'POST', data: form.serialize(), dataType: 'json' })
        .done(function(res){
          if(res.success){
            $('#modalRegMark').modal('hide');
            form[0].reset();
            showToast(res.message || 'Marca cadastrada com sucesso.', 'success');
            refreshMarksTable();
          } else {
            showToast(res.message || 'Erro ao salvar marca', 'error');
          }
        }).fail(function(xhr){
          console.error('Erro AJAX save_mark:', xhr.responseText || xhr.statusText);
          showToast('Erro ao salvar marca', 'error');
        });
      });

      // Edit
      $('#tbmarks').on('click', '.edit-mark', function(){
        var id = $(this).data('id');
        $.getJSON('/get_mark?id=' + id, function(data){
          if(!data || !data.id) { showToast('Registro não encontrado', 'error'); return; }
          $('#edit_mark_id').val(data.id);
          $('#edit_nm_name').val(data.nm_name);
          $('#edit_cartype').val(data.cartype);
          $('#edit_ds_soon').val(data.ds_soon);
          $('#markEditAlert').hide();
          $('#modalEditMark').modal('show');
        }).fail(function(){ showToast('Erro ao buscar marca', 'error'); });
      });

      // Update
      $('#btnUpdateMark').on('click', function(){
        var form = $('#formEditMark');
        $.ajax({ url: form.attr('action'), method: 'POST', data: form.serialize(), dataType: 'json' })
        .done(function(res){
          if(res.success){
            $('#modalEditMark').modal('hide');
            showToast(res.message || 'Marca atualizada com sucesso.', 'success');
            refreshMarksTable();
          } else { showMarkAlert('#markEditAlert', res.message || 'Erro ao atualizar marca'); }
        }).fail(function(){ showMarkAlert('#markEditAlert', 'Erro ao atualizar marca'); });
      });

      // Delete
      var deleteMarkId = null;

      $('#tbmarks').on('click', '.delete-mark', function(){
        deleteMarkId = $(this).data('id');
        $('#modalExcluirMarca').modal('show');
      });

      $('#confirmDeleteMarkBtn').click(function(){
        if(!deleteMarkId) return;
        $.post('/delete_mark', { id: deleteMarkId }, function(res){
          if(res.success){
            $('#modalExcluirMarca').modal('hide');
            showToast('Exclusão realizada com sucesso.', 'error');
            refreshMarksTable();
          } else {
            $('#modalExcluirMarca').modal('hide');
            showToast(res.message || 'Erro ao excluir', 'error');
          }
        }, 'json').fail(function(){
          $('#modalExcluirMarca').modal('hide');
          showToast('Erro na requisição', 'error');
        });
      });
    });
  </script>

