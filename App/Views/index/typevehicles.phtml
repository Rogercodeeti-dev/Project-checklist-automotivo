  <script src="/plugins/datatables/jquery.dataTables.min.js"></script>
  <script src="/plugins/datatables/dataTables.bootstrap.min.js"></script>
  <script>
    $(function(){
      var dtConfig = { language: { url: '/plugins/datatables/Portuguese.json' } };
      $('#tbtypevehicles').DataTable(dtConfig);

      function showToast(message, type) {
        toastr.options = { closeButton: true, progressBar: true, positionClass: 'toast-top-right', timeOut: '3000' };
        if (type === 'success') { toastr.success(message); }
        else { toastr.error(message); }
      }

      function refreshTypeVehiclesTable(callback) {
        $.post('/listtypevehicle', function(html){
          var tbody = $(html).find('#tbtypevehicles tbody');
          var table = $('#tbtypevehicles').DataTable();
          table.destroy();
          $('#tbtypevehicles tbody').html(tbody.html());
          $('#tbtypevehicles').DataTable(dtConfig);
          if (typeof callback === 'function') callback();
        });
      }

      $('#btnSaveTypeVehicle').on('click', function(){
        var form = $('#formTypeVehicle');
        $.ajax({ url: form.attr('action'), method: 'POST', data: form.serialize(), dataType: 'json' })
        .done(function(res){
          if(res.success){
            $('#modalRegTypeVehicle').modal('hide');
            form[0].reset();
            showToast(res.message || 'Tipo de veículo cadastrado com sucesso.', 'success');
            refreshTypeVehiclesTable();
          } else {
            showToast(res.message || 'Erro ao salvar tipo de veículo', 'error');
          }
        }).fail(function(xhr){
          console.error('Erro AJAX save_typevehicle:', xhr.responseText || xhr.statusText);
          showToast('Erro ao salvar tipo de veículo', 'error');
        });
      });

      // Edit
      $('#tbtypevehicles').on('click', '.edit-typevehicle', function(){
        var id = $(this).data('id');
        $.getJSON('/get_typevehicle?id=' + id, function(data){
          if(!data || !data.id) { showToast('Registro não encontrado', 'error'); return; }
          $('#edit_typevehicle_id').val(data.id);
          $('#edit_ds_type').val(data.ds_type);
          $('#modalEditTypeVehicle').modal('show');
        }).fail(function(){ showToast('Erro ao buscar tipo de veículo', 'error'); });
      });

      // Update
      $('#btnUpdateTypeVehicle').on('click', function(){
        var form = $('#formEditTypeVehicle');
        $.ajax({ url: form.attr('action'), method: 'POST', data: form.serialize(), dataType: 'json' })
        .done(function(res){
          if(res.success){
            $('#modalEditTypeVehicle').modal('hide');
            showToast(res.message || 'Tipo de veículo atualizado com sucesso.', 'success');
            refreshTypeVehiclesTable();
          } else { showToast(res.message || 'Erro ao atualizar tipo de veículo', 'error'); }
        }).fail(function(){ showToast('Erro ao atualizar tipo de veículo', 'error'); });
      });

      // Delete
      var deleteTypeVehicleId = null;

      $('#tbtypevehicles').on('click', '.delete-typevehicle', function(){
        deleteTypeVehicleId = $(this).data('id');
        $('#modalExcluirTypeVehicle').modal('show');
      });

      $('#confirmDeleteTypeVehicleBtn').click(function(){
        if(!deleteTypeVehicleId) return;
        $.post('/delete_typevehicle', { id: deleteTypeVehicleId }, function(res){
          if(res.success){
            $('#modalExcluirTypeVehicle').modal('hide');
            showToast('Tipo de veículo excluído com sucesso.', 'success');
            refreshTypeVehiclesTable();
          } else {
            $('#modalExcluirTypeVehicle').modal('hide');
            showToast(res.message || 'Erro ao excluir', 'error');
          }
        }, 'json').fail(function(){
          $('#modalExcluirTypeVehicle').modal('hide');
          showToast('Erro na requisição', 'error');
        });
      });
    });
  </script>

  <div class="modal fade" id="modalRegTypeVehicle" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
      <div class="modal-content custom-modal-content">
        <div class="modal-header"><button type="button" class="close" data-dismiss="modal">&times;</button>
          <h4 class="modal-title">Cadastrar Tipo de Veículo</h4></div>
        <div class="modal-body">
          <div id="typevehicleCreateAlert" class="alert" style="display:none;"></div>
          <form id="formTypeVehicle" action="/save_typevehicle" method="post">
            <div class="form-group">
              <label>Tipo de Veículo</label>
              <input type="text" name="ds_type" class="form-control" required>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
          <button type="button" id="btnSaveTypeVehicle" class="btn btn-primary">Salvar</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal de Confirmacao de Exclusao -->
  <div class="modal fade" id="modalExcluirTypeVehicle" tabindex="-1" role="dialog" aria-labelledby="confirmDeleteTypeVehicleLabel">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <div class="modal-header">
