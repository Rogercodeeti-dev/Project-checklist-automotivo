  <script>
    jQuery(function($) {
      function showMessage(element, type, message) {
        element.removeClass('alert-success alert-danger').addClass(type === 'success' ? 'alert-success' : 'alert-danger');
        element.text(message).show();
      }

      function renderPreview(input, previewSelector) {
        if (input.files && input.files[0]) {
          var reader = new FileReader();
          reader.onload = function(e) {
            $(previewSelector).attr('src', e.target.result);
          };
          reader.readAsDataURL(input.files[0]);
        }
      }

      $('#profile_ds_photo, #ds_system_logo_file, #ds_reporticon_file, #ds_icon_file').on('change', function() {
        var previewMap = {
          'profile_ds_photo': '#profilePhotoPreview',
          'ds_system_logo_file': '#logoPreview',
          'ds_reporticon_file': '#reportIconPreview',
          'ds_icon_file': '#systemIconPreview'
        };
        renderPreview(this, previewMap[this.id]);
      });

      $('#profileForm').on('submit', function(e) {
        e.preventDefault();
        var form = new FormData(this);
        $.ajax({
          url: $(this).attr('action'),
          type: 'POST',
          data: form,
          processData: false,
          contentType: false,
          dataType: 'json'
        }).done(function(response) {
          if (response.success) {
            showMessage($('#profileAlert'), 'success', response.message || 'Perfil atualizado com sucesso.');
            if (response.user && response.user.ds_photo) {
              $('#profilePhotoPreview, .user-image, .user-header img').attr('src', response.user.ds_photo);
            }
          } else {
            showMessage($('#profileAlert'), 'error', response.message || 'Não foi possível atualizar o perfil.');
          }
        }).fail(function() {
          showMessage($('#profileAlert'), 'error', 'Erro de comunicação com o servidor.');
        });
      });

      $('#settingsForm').on('submit', function(e) {
        e.preventDefault();
        var form = new FormData(this);
        $.ajax({
          url: $(this).attr('action'),
          type: 'POST',
          data: form,
          processData: false,
          contentType: false,
          dataType: 'json'
        }).done(function(response) {
          if (response.success) {
            showMessage($('#settingsAlert'), 'success', response.message || 'Configurações salvas.');
            if (response.settings) {
              if (response.settings.ds_system_logo) {
                $('#logoPreview').attr('src', response.settings.ds_system_logo);
                $('#ds_system_logo').val(response.settings.ds_system_logo);
              }
              if (response.settings.ds_reporticon) {
                $('#reportIconPreview').attr('src', response.settings.ds_reporticon);
                $('#ds_reporticon').val(response.settings.ds_reporticon);
              }
              if (response.settings.ds_icon) {
                $('#systemIconPreview').attr('src', response.settings.ds_icon);
                $('#ds_icon').val(response.settings.ds_icon);
              }
            }
          } else {
            showMessage($('#settingsAlert'), 'error', response.message || 'Não foi possível salvar as configurações.');
          }
        }).fail(function() {
          showMessage($('#settingsAlert'), 'error', 'Erro de comunicação com o servidor.');
        });
      });

      // Limpa alertas ao fechar os modais
      $('#profileModal, #configModal').on('hidden.bs.modal', function() {
        $(this).find('.alert').hide();
      });

      // Busca endereço via VIACEP quando CEP for informado
      function clearAddressFields() {
        $('#ds_street').val('');
        $('#ds_neighborhood').val('');
        $('#nm_city').val('');
        $('#sg_state').val('');
      }

      function fetchAddressByCep(cep) {
        var cepDigits = (cep || '').replace(/\D/g, '');
        if (!cepDigits) {
          clearAddressFields();
          return;
        }
        if (cepDigits.length !== 8) {
          showMessage($('#settingsAlert'), 'error', 'CEP inválido. Informe 8 dígitos.');
          clearAddressFields();
          return;
        }

        // Consulta via VIACEP
        $.ajax({
          url: 'https://viacep.com.br/ws/' + cepDigits + '/json/',
          method: 'GET',
          dataType: 'json',
          timeout: 10000
        }).done(function(data) {
          if (!data || data.erro) {
            showMessage($('#settingsAlert'), 'error', 'CEP não encontrado.');
            clearAddressFields();
            return;
          }
          $('#ds_street').val(data.logradouro || '');
          $('#ds_neighborhood').val(data.bairro || '');
          $('#nm_city').val(data.localidade || '');
          $('#sg_state').val(data.uf || '');
          $('#settingsAlert').hide();
        }).fail(function() {
          showMessage($('#settingsAlert'), 'error', 'Erro ao consultar CEP. Tente novamente.');
        });
      }

      // Trigger ao perder foco e ao colar/alterar o campo CEP
      $('#nr_zipcode').on('blur change paste', function() {
        var v = $(this).val();
        fetchAddressByCep(v);
      });

      // Ao abrir o modal de configurações, se já houver CEP preenchido, buscar endereço
      $('#configModal').on('shown.bs.modal', function() {
        var v = $('#nr_zipcode').val();
        if (v && v.replace(/\D/g, '').length === 8) {
          fetchAddressByCep(v);
        }
      });
    });
  </script>

